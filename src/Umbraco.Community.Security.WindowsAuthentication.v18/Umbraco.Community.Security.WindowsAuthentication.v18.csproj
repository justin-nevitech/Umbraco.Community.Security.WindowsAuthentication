<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Umbraco 18 variant of the package.

    This project owns NO sources of its own: it compiles the same files as the Umbraco 17
    project via ..\Umbraco.Community.Security.WindowsAuthentication\WindowsAuthentication.Shared.props,
    and produces the same assembly name and PackageId. The differences are exactly:

      * Umbraco package range -> [18,19)
      * the UMBRACO_18 compilation symbol, available for any code that has to differ on Umbraco 18
        (none currently does)

    Add new source files to the Umbraco.Community.Security.WindowsAuthentication shared source
    folder; they are picked up here automatically.

    This produces the 18.x releases of the package. See docs/BUILDING.md.
  -->

  <Import Project="..\Umbraco.Community.Security.WindowsAuthentication\WindowsAuthentication.Shared.props" />
  <Import Project="..\Umbraco.Community.Security.WindowsAuthentication\SharedBackofficeAssets.targets" />

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);UMBRACO_18</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.0.0, 19.0.0)" />
  </ItemGroup>

</Project>
