{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [ "src" ]
}
