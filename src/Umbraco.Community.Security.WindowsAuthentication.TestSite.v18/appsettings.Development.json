{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Umbraco.Community.Security.WindowsAuthentication": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      },
      "Security": {
        "UserDefaultLockoutTimeInMinutes": 5
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "WindowsAuth-Test-1234"
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "ApiKey": "test-delivery-api-key"
      }
    }
  },
  "TestSite": {
    "SeedTestData": true,
    "EnableTestAuthentication": true,
    "JwtSigningKey": "test-site-signing-key-for-acceptance-tests-only-0123456789abcdef",
    "ApiKey": "test-api-key",
    "BasicUsername": "basic-user",
    "BasicPassword": "basic-pass"
  }
}
